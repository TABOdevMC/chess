rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.admin == true;
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.admin == false;
      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.admin == resource.data.admin;
      allow delete: if false;
    }

    match /games/{gameId} {
      // The multiplayer screen lists available games. Firestore rules cannot
      // safely use a query as a per-document filter, so authenticated players
      // need collection read access here.
      allow read: if signedIn();
      allow create: if signedIn();
      allow update: if signedIn()
        && (isAdmin()
          || request.auth.uid == resource.data.white
          || request.auth.uid == resource.data.black);
      allow delete: if false;
    }

    match /matchmaking/{entryId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid;
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid;
      allow delete: if signedIn()
        && resource.data.uid == request.auth.uid;
    }

    match /admin/{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
