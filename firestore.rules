rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.admin == true;
    }

    match /users/{userId} {
      // Authenticated players need to read users for the Elo leaderboard.
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == userId
        && request.resource.data.admin == false;
      allow update: if signedIn() && request.auth.uid == userId
        && request.resource.data.admin == resource.data.admin;
      allow delete: if false;
    }

    match /games/{gameId} {
      allow read: if signedIn() && (isAdmin()
        || request.auth.uid == resource.data.white
        || request.auth.uid == resource.data.black);
      allow create: if signedIn();
      allow update: if signedIn() && (isAdmin()
        || request.auth.uid == resource.data.white
        || request.auth.uid == resource.data.black);
      allow delete: if false;
    }

    match /matchmaking/{entryId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if signedIn() && resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }
  }
}
